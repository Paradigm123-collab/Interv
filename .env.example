# API Configuration
VITE_API_URL=https://api.paradigm-assessment.com
VITE_API_VERSION=v1

# Authentication
VITE_AUTH_DOMAIN=auth.paradigm-assessment.com
VITE_AUTH_CLIENT_ID=your_client_id

# Feature Flags
VITE_ENABLE_AI_PROCTORING=true
VITE_ENABLE_BIAS_DETECTION=true
VITE_ENABLE_COMPLIANCE=true

# Third-party Services
VITE_ANALYTICS_ID=your_analytics_id
VITE_SENTRY_DSN=your_sentry_dsn

# Environment
VITE_ENVIRONMENT=production